{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaultline-frontend",
  "main": "worker.js",
  "routes": [
    { "pattern": "vaultlineofficial.us", "custom_domain": true }
  ],
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "define": {
    "VAULTLINE_DEPLOY_MARKER": "\"2026-09-16-generated-assets\""
  }
}
